# Secrets — never commit. The API key and warehouse credentials live in .env only.
# `.env*` also catches .envrc (direnv) and .env-prod; a template would be `.env.example`
# and needs a `!` line here first.
.env*
!.env.example
*.pem
credentials*

# Data — publish aggregates and code, never the raw corpus (PROJECT_BRIEF §2.5).
# data/snapshots/ (the weekly public aggregates, Phase 4) and data/damir/ (the
# tracked, numbers-only claim-cost fit, Phase 7b) are the tracked subtrees;
# `data/*` (not `data/`) is what lets the negations below work. The raw fetched
# DAMIR month under data/cache/damir/ stays ignored (gigabytes, never committed).
data/*
!data/snapshots/
!data/damir/
*.duckdb
*.duckdb.wal

# Claude Code config is local-only: a tracked settings/.mcp.json would auto-run
# an inbound branch's hooks or MCP servers for anyone opening the repo
# (CLAUDE.md → Project tooling). Agent, command and skill prose and hook
# scripts ARE tracked.
.claude/settings.json
.claude/settings.local.json
.mcp.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
